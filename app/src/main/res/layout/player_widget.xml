<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews layout for the Rustym player widget (art + song info + transport). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/wArt"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:id="@+id/wTitleBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/wTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/wArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_idle" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/wPrev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_w_prev"
        android:contentDescription="@string/widget_prev" />

    <ImageButton
        android:id="@+id/wPlayPause"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_w_play"
        android:contentDescription="@string/widget_playpause" />

    <ImageButton
        android:id="@+id/wNext"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_w_next"
        android:contentDescription="@string/widget_next" />
</LinearLayout>
